{
  "name": "@sbugallo/opencode-vpet",
  "version": "0.2.0-dev.0",
  "description": "An OpenCode virtual-pet plugin with /vpet-spawn, /vpet-freeze, /vpet-unfreeze, /vpet-set, /vpet-dex, and /vpet-history commands.",
  "author": "Sergio Bugallo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbugallo/opencode-vpet.git"
  },
  "homepage": "https://github.com/sbugallo/opencode-vpet#readme",
  "bugs": {
    "url": "https://github.com/sbugallo/opencode-vpet/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "virtual-pet",
    "vpet",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.5",
    "node": ">=20",
    "opencode": ">=1.18.10"
  },
  "main": "./dist/index.js",
  "bin": {
    "opencode-vpet": "./dist/cli.js"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@opencode-ai/plugin": "^1.18.10",
    "@opencode-ai/sdk": "^1.18.10",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "semver": "^7.7.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.10",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:persistence": "bun test ./tests/persistence/sqlite-migrations.persistence.ts ./tests/persistence/sqlite-vpet-repository.persistence.ts",
    "format": "biome format --write src tests scripts package.json biome.json tsconfig*.json",
    "format:check": "biome format src tests scripts package.json biome.json tsconfig*.json",
    "lint": "biome lint src tests scripts package.json biome.json tsconfig*.json",
    "lint:fix": "biome lint --write src tests scripts package.json biome.json tsconfig*.json",
    "check": "biome ci src tests scripts package.json biome.json tsconfig*.json && bun run typecheck && bun run typecheck:tests && bun run typecheck:release-metadata",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:release-metadata": "tsc -p tsconfig.release-metadata.json --noEmit",
    "build": "bun scripts/build.ts",
    "prepack": "bun scripts/prepack.ts",
    "release:check": "bun run check && bun test && bun run prepack && npm pack --dry-run --json"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}

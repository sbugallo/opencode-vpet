{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/**",
      "scripts/**",
      "package.json",
      "tsconfig*.json",
      "!packages/**/dist/**",
      "!packages/**/build",
      "!packages/cursor-digital-pet/hook-bridge.js",
      "!packages/digital-pet-core/src/data/monster-frame-data.ts",
      "!tests/**/*.jsonc",
      "!.omo/",
      "!node_modules/",
      "!coverage/",
      "!**/generated/"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/opencode-digital-pet/src/tui/sidebar-card.tsx",
        "packages/opencode-digital-pet/src/tui/digital-pet-dex-dialog.tsx",
        "packages/opencode-digital-pet/src/tui/digital-pet-history-dialog.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}

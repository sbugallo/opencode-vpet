{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node", "vscode"],
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "src/types"]
}

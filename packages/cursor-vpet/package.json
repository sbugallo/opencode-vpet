{
  "name": "cursor-vpet",
  "displayName": "Cursor VPet",
  "description": "Digimon virtual pet for Cursor that evolves with Agent token usage.",
  "version": "0.2.0-dev.0",
  "publisher": "sbugallo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbugallo/opencode-vpet.git",
    "directory": "packages/cursor-vpet"
  },
  "homepage": "https://github.com/sbugallo/opencode-vpet#readme",
  "bugs": {
    "url": "https://github.com/sbugallo/opencode-vpet/issues"
  },
  "keywords": [
    "cursor",
    "vpet",
    "virtual-pet",
    "digimon",
    "agent",
    "ai",
    "sidebar",
    "opencode"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": "24.11.0",
    "bun": "1.3.5"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "cursorVpet.sidebar",
          "name": "VPet",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorVpet.spawn",
        "title": "Cursor VPet: Spawn Partner"
      },
      {
        "command": "cursorVpet.freeze",
        "title": "Cursor VPet: Freeze"
      },
      {
        "command": "cursorVpet.unfreeze",
        "title": "Cursor VPet: Unfreeze"
      },
      {
        "command": "cursorVpet.set",
        "title": "Cursor VPet: Set Digimon"
      },
      {
        "command": "cursorVpet.dex",
        "title": "Cursor VPet: Open Dex"
      },
      {
        "command": "cursorVpet.history",
        "title": "Cursor VPet: Open History"
      },
      {
        "command": "cursorVpet.installHooks",
        "title": "Cursor VPet: Install Hooks"
      },
      {
        "command": "cursorVpet.uninstallHooks",
        "title": "Cursor VPet: Uninstall Hooks"
      },
      {
        "command": "cursorVpet.testBattle",
        "title": "Cursor VPet: Test Evolution Battle (debug)"
      }
    ],
    "configuration": {
      "title": "Cursor VPet",
      "properties": {
        "vpet.databasePath": {
          "type": "string",
          "default": "",
          "description": "Override path to pet.db (default: shared opencode-vpet/pet.db)"
        },
        "vpet.usage.settleDelayMs": {
          "type": "number",
          "default": 4000,
          "description": "Initial delay before API watermark fallback (ms)"
        }
      }
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "bun test",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish:openvsx": "npx ovsx publish *.vsix -p \"$OVSX_PAT\"",
    "vscode:prepublish": "bun run build"
  },
  "dependencies": {
    "@sbugallo/vpet-core": "workspace:*",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "ovsx": "0.10.0",
    "typescript": "5.9.3"
  }
}

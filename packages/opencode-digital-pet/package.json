{
  "name": "@jcendal/opencode-digital-pet",
  "version": "0.2.0-dev.0",
  "description": "An OpenCode virtual-pet plugin with /digital-pet-spawn, /digital-pet-freeze, /digital-pet-unfreeze, /digital-pet-set, /digital-pet-dex, and /digital-pet-history commands.",
  "author": "Jorge Cendal",
  "contributors": [
    "Sergio Bugallo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcendal/digital-pet.git",
    "directory": "packages/opencode-digital-pet"
  },
  "homepage": "https://github.com/jcendal/digital-pet#readme",
  "bugs": {
    "url": "https://github.com/jcendal/digital-pet/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "virtual-pet",
    "digital-pet",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "packageManager": "npm@11.6.1",
  "engines": {
    "bun": "1.3.5",
    "node": "24.11.0",
    "opencode": ">=1.18.10"
  },
  "main": "./dist/index.js",
  "bin": {
    "opencode-digital-pet": "./dist/cli.js"
  },
  "dependencies": {
    "@jcendal/digital-pet-animation": "0.2.0-dev.0",
    "@jcendal/digital-pet-core": "0.2.0-dev.0",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@opencode-ai/plugin": "^1.18.10",
    "@opencode-ai/sdk": "^1.18.10",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/semver": "7.7.1",
    "semver": "7.7.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.10 <2",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:persistence": "bun test ./tests/persistence/sqlite-migrations.persistence.ts ./tests/persistence/sqlite-digital-pet-repository.persistence.ts ./tests/persistence/sqlite-digital-pet-control.persistence.ts ./tests/persistence/sqlite-usage-event-toast.persistence.test.ts",
    "format": "biome format --write src tests scripts package.json",
    "format:check": "biome format src tests scripts package.json",
    "lint": "biome lint src tests scripts package.json",
    "check": "biome ci src tests scripts package.json && npm run typecheck && npm run typecheck:scripts && npm run typecheck:tests",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "build": "node esbuild.mjs",
    "prepack": "node --experimental-strip-types scripts/prepack.ts",
    "postpack": "node --experimental-strip-types scripts/postpack.ts",
    "release:check": "npm run check && npm run test && npm run test:persistence && npm pack --dry-run --json"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
